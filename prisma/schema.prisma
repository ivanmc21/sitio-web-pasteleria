// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id                   Int      @id @default(autoincrement())
  slug                 String?  @unique
  name                 String
  description          String
  price                Int
  category             String
  categorySlug         String
  image                String
  images               String[]   @default([])
  badge                String?
  available            Boolean  @default(true)
  size                 String
  capacity             String?
  ingredients          String[]   @default([])
  nutritionalInfo      String?
  customizationOptions String[]   @default([])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Sucursal {
  id          Int     @id @default(autoincrement())
  nombre      String
  direccion   String
  telefono    String
  horario     String
  lat         Float
  lng         Float
  esPrincipal Boolean @default(false)
  order       Int     @default(0)
  neighborhood String?
}

enum ContactStatus {
  pendiente
  leido
  respondido
  archivado
}

model ContactMessage {
  id             Int           @id @default(autoincrement())
  firstName      String
  lastName       String
  secondLastName String?
  email          String
  phone          String?
  message        String
  status         ContactStatus @default(pendiente)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}
